# Copy to .env and fill in from the Supabase dev project (Settings → API).
# The anon key is safe for the browser; the service_role key is NOT — it is
# only used by local scripts (migration loader, RLS tests) and never shipped.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (scripts/, never imported by the app):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
